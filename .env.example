# Copia este archivo como ".env" y completa los valores. El archivo ".env" NO se sube a Git.
# Ejecutar con:  uvicorn app.main:app --reload --env-file .env

# Ruta del archivo de base de datos SQLite
DATABASE_PATH=expenses.db

# Clave secreta para firmar los tokens JWT (OBLIGATORIA, mínimo 32 caracteres).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
# Si cambia, todas las sesiones activas dejan de ser válidas.
SECRET_KEY=

# Minutos de vida del token de acceso (entre 1 y 1440). Por defecto: 30
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Límites de peticiones (todos opcionales; se muestran los valores por defecto).
# Formato: "10/minute", "5 per 15 minute", "20/hour"
# Intentos de login por IP:
# RATE_LIMIT_LOGIN_IP=10/minute
# Fallos de login por cuenta antes de bloquearla un rato:
# RATE_LIMIT_LOGIN_ACCOUNT=5 per 15 minute
# Registros por IP:
# RATE_LIMIT_REGISTER=10/hour
# Apagar todos los límites (solo para pruebas):
# RATE_LIMIT_ENABLED=true
# Dónde se guardan los contadores. Con varios servidores usa redis://host:6379
# RATE_LIMIT_STORAGE_URI=memory://
